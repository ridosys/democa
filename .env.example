# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Seed admin (used once by prisma/seed.ts to create the first مدير النظام)
SEED_ADMIN_NAME="مدير النظام"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Cloudinary (Phase 3 — product image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Required before deleting an invoice, customer, or payment
DELETE_CONFIRM_PASSWORD=""

# DeepSeek API key — powers the AI purchase-invoice scanner
# (/dashboard/purchases/scan). Server-side only; never exposed to the browser.
# Get one at https://platform.deepseek.com. Uses the "deepseek-flash" vision model.
DEEPSEEK_API_KEY=""

# Optional — only needed if your Postgres client requires an unpooled
# connection (e.g. Prisma <5.10). Use your own project's unpooled URL here.
# DATABASE_URL_UNPOOLED=""

# Deployment-level kill switch for the Business Type & Feature management
# page (/dashboard/settings/business) and everything it can change — not
# the same as the in-app feature toggles that page itself manages, which
# stay database-driven and admin-editable regardless of this. Useful for a
# hosted plan where the reseller, not the end customer's admin, controls
# which features are available. Defaults to enabled; set to "false" to
# disable — the page 404s/redirects and the nav link disappears.
BUSINESS_SETTINGS_MANAGEMENT_ENABLED="true"